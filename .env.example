# Copie este arquivo para .env e ajuste os valores do ambiente.
# Nunca versione senhas, chaves ou credenciais reais.

# Aplicacao
# Nome exibido nos titulos e menus.
APP_NAME="Sistema Interno de Compras e Licitacoes"
# URL publica do sistema, sem barra no final.
APP_URL=https://catalogo-licitacao.esturvo.intra
# Ambiente: production ou development.
APP_ENV=production
# Caminho publico do brasao municipal.
MUNICIPAL_LOGO_PATH=/assets/brasao-municipio.png

# Identidade institucional do DOD
# Nome oficial da entidade.
DOD_ENTITY_NAME="PREFEITURA MUNICIPAL DE ESPIRITO SANTO DO TURVO"
# Estado exibido nos documentos.
DOD_ENTITY_STATE="ESTADO DE SAO PAULO"
# Municipio e UF usados em local e data.
DOD_ENTITY_CITY="Espirito Santo do Turvo - SP"
# CNPJ padrao da entidade.
DOD_ENTITY_CNPJ=57.264.509/0001-69
# Logos laterais do cabecalho do DOD.
DOD_LOGO_LEFT_PATH=/assets/municipio-agro.png
DOD_LOGO_RIGHT_PATH=/assets/municipio-verde-azul.png

# Toolkit flutuante
# Ativa ou desativa o toolkit nas telas internas.
TOOLKIT_ENABLED=true
# Endereco do JavaScript publicado pelo toolkit.
TOOLKIT_SCRIPT_URL=https://assets.esturvo.intra/toolkit/current/toolkit.min.js
# Textos exibidos no painel flutuante.
TOOLKIT_TITLE=Ferramentas rápidas
TOOLKIT_SUBTITLE=Apoio ao trabalho diário
# Cores em hexadecimal completo: #RRGGBB.
TOOLKIT_ACCENT=#2f6f4f
TOOLKIT_ACCENT_DARK=#245a3f
# Lado da tela: left ou right.
TOOLKIT_POSITION=right
# Atalho de teclado para abrir o toolkit.
TOOLKIT_SHORTCUT=Alt+T

# Banco de dados PostgreSQL
# Servidor e porta do PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
# Banco, usuario e senha da aplicacao.
DB_NAME=catalogo_licitacao
DB_USER=user_catalogo_licitacao
DB_PASS=troque_essa_senha

# Integracao com OpenAI
# Chave da API; mantenha vazia se a integracao nao for usada.
OPENAI_API_KEY=sua_chave_aqui
# Modelo utilizado nas sugestoes de texto.
OPENAI_MODEL=gpt-4.1-mini

# Autenticacao AD/LDAP
# Ativa o login pelo diretorio corporativo.
AUTH_LDAP_ENABLED=false
# Servidor, porta e timeout da conexao LDAP.
AUTH_LDAP_HOST=athena.esturvo.intra
AUTH_LDAP_PORT=389
# Use SSL para LDAPS ou TLS para StartTLS; nao ative ambos.
AUTH_LDAP_USE_SSL=false
AUTH_LDAP_USE_TLS=false
# Tempo limite da conexao, em segundos.
AUTH_LDAP_TIMEOUT=5
# Base onde usuarios e grupos serao pesquisados.
AUTH_LDAP_BASE_DN="DC=esturvo,DC=intra"
# Conta de servico usada para pesquisar o diretorio.
AUTH_LDAP_BIND_DN=""
AUTH_LDAP_BIND_PASSWORD=""
# Filtro LDAP; {login} e substituido pelo usuario informado.
AUTH_LDAP_USER_FILTER="(|(sAMAccountName={login})(userPrincipalName={login})(mail={login}))"
# Sufixo UPN e dominio NetBIOS usados na autenticacao.
AUTH_LDAP_ACCOUNT_SUFFIX="@esturvo.intra"
AUTH_LDAP_DOMAIN=ESTURVO
# Cria automaticamente o usuario local no primeiro login.
AUTH_LDAP_AUTO_CREATE=true
# Sincroniza nome, e-mail e demais dados do perfil.
AUTH_LDAP_SYNC_PROFILE=true
# Atualiza o perfil de acesso conforme os grupos do AD.
AUTH_LDAP_SYNC_ROLE=true
# Perfil aplicado quando nenhum grupo configurado corresponder.
# Valores: admin, manager, operator ou viewer.
AUTH_LDAP_DEFAULT_ROLE=viewer
# Permite login local, especialmente para administradores.
AUTH_LDAP_LOCAL_FALLBACK=true
# Dominio usado ao gerar e-mail para conta sem atributo mail.
AUTH_LDAP_FALLBACK_EMAIL_DOMAIN=esturvo.intra
# Grupos do AD associados a cada perfil do sistema.
# Para varios grupos, separe os nomes por ponto e virgula.
AUTH_LDAP_ADMIN_GROUPS="Catalogo Licitacao Admins"
AUTH_LDAP_MANAGER_GROUPS="Catalogo Licitacao Gestores"
AUTH_LDAP_OPERATOR_GROUPS="Catalogo Licitacao Operadores"
AUTH_LDAP_VIEWER_GROUPS="Catalogo Licitacao Consulta"
